flowchart TB
    Cliente["Cliente HTTP"]
    subgraph Aplicacion["AutoMarket · proceso Go"]
        Router["Gin router<br/>cmd/server/main.go"]
        AuditMW["AccountingMiddleware<br/>registra cada solicitud"]
        WebUI["Interfaz HTML<br/>web/templates/index.html"]
        AuthMW["AuthenticationMiddleware<br/>valida Bearer token"]
        RoleMW["AuthorizationMiddleware<br/>comprueba rol en Store"]
        AuthService["AuthService<br/>registro y login"]
        VehicleService["VehicleService<br/>catálogo, publicación y venta"]
        AdminService["AdminService<br/>aprobación y eliminación"]
        AuthHandlers["Auth handlers<br/>registro y login"]
        VehicleHandlers["Vehicle handlers<br/>catálogo, crear y reportar venta"]
        AdminHandlers["Admin handlers<br/>aprobar y eliminar"]
        TokenStore["TokenStore<br/>tokens en memoria"]
        Password["Password helpers<br/>salt aleatorio + SHA-256 iterado"]
        Models["Modelos<br/>User · Vehicle · AuditLog"]
        Store["Store<br/>mutex + JSON en disco"]
        Startup["Inicio del servidor<br/>seed admin + verificar auditoría"]
    end
    subgraph Archivos["Persistencia local · directorio data/"]
        Users[("users.json")]
        Vehicles[("vehicles.json")]
        Audit[("audit.json<br/>hash encadenado SHA-256")]
    end

